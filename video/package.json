{
  "name": "baton-video",
  "version": "1.0.0",
  "description": "Remotion animation for the Baton README hero",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render ReadmeHero out/thumbnail.mp4 --codec=h264 --crf=18",
    "gif": "ffmpeg -y -i out/thumbnail.mp4 -vf \"fps=15,scale=1000:-2:flags=lanczos,split[s0][s1];[s0]palettegen=max_colors=256:stats_mode=diff[p];[s1][p]paletteuse=dither=none:diff_mode=rectangle\" -loop 0 out/thumbnail.gif",
    "ship": "npm run render && npm run gif && cp out/thumbnail.mp4 out/thumbnail.gif ../assets/readme/",
    "still": "remotion still ReadmeHero"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@remotion/cli": "^4.0.523",
    "@remotion/google-fonts": "^4.0.523",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.523"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "private": true
}
